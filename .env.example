# העתיקו קובץ זה ל-.env.local ומלאו את הערכים מ-Firebase Console
# (Project settings → General → Your apps → SDK setup and configuration)
# הקובץ .env.local נמצא ב-.gitignore ואינו נשמר ב-git.
#
# הערה: מפתחות Firebase של אפליקציית web הם מזהים ציבוריים מעצם טיבם -
# ההגנה על הנתונים מתבצעת ב-Firestore Security Rules וב-Authorized domains,
# ולא בהסתרת המפתח. אין לשמור כאן סודות שרת (service account, CI token וכו').

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
