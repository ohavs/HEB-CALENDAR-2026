<?xml version="1.0" encoding="utf-8"?>
<!-- התצוגה המקדימה של וידג׳ט התאריך בבורר. היא אינה מריצה קוד ולכן אינה
     יכולה לצייר את התמונה של widget_date - זה קירוב בטקסט, עם תאריך לדוגמה. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_date_bg"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/widget_preview_date_weekday"
        android:fontFamily="@font/heebo_medium"
        android:textColor="@color/widget_date_ink"
        android:alpha="0.65"
        android:textSize="13sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:layoutDirection="ltr"
        android:textDirection="ltr"
        android:text="@string/widget_preview_date"
        android:fontFamily="@font/six_caps"
        android:includeFontPadding="false"
        android:textColor="@color/widget_date_ink"
        android:textSize="90sp"
        android:maxLines="1"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="30sp"
        android:autoSizeMaxTextSize="400sp"
        android:autoSizeStepGranularity="2sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/widget_preview_date_hebrew"
        android:fontFamily="@font/heebo_medium"
        android:textColor="@color/widget_date_ink"
        android:alpha="0.65"
        android:textSize="13sp" />
</LinearLayout>
