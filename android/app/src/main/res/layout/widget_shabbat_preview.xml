<?xml version="1.0" encoding="utf-8"?>
<!-- התצוגה המקדימה של וידג׳ט השבת בבורר של המשגר - ראו widget_preview.xml.
     עותק של widget_shabbat עם זמנים לדוגמה; מה שמשתנה שם משתנה גם כאן. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:layoutDirection="rtl"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:background="@drawable/widget_field_bg"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:paddingStart="6dp"
            android:paddingEnd="6dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_candles"
                android:textColor="@color/widget_muted"
                android:textSize="10sp"
                android:maxLines="1" />

            <TextView
                android:text="@string/widget_preview_candles"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingTop="1dp"
                android:textColor="@color/widget_ink"
                android:textSize="22sp"
                android:textStyle="bold"
                android:maxLines="1" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:background="@drawable/widget_field_bg"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:paddingStart="6dp"
            android:paddingEnd="6dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_havdalah"
                android:textColor="@color/widget_muted"
                android:textSize="10sp"
                android:maxLines="1" />

            <TextView
                android:text="@string/widget_preview_havdalah"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingTop="1dp"
                android:textColor="@color/widget_ink"
                android:textSize="22sp"
                android:textStyle="bold"
                android:maxLines="1" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:text="@string/widget_preview_shabbat_day"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="7dp"
        android:textColor="@color/widget_ink"
        android:textSize="12sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end" />

    <TextView
        android:text="@string/widget_preview_shabbat_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="1dp"
        android:textColor="@color/widget_muted"
        android:textSize="12sp"
        android:maxLines="1"
        android:ellipsize="end" />

    <TextView
        android:text="@string/widget_preview_city"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="3dp"
        android:textColor="@color/widget_faint"
        android:textSize="10sp"
        android:maxLines="1" />

</LinearLayout>
