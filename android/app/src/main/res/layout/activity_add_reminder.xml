<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/widget_dialog_bg"
    android:layoutDirection="rtl"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/widget_add"
        android:textColor="@color/widget_ink"
        android:textSize="17sp"
        android:textStyle="bold"
        android:paddingBottom="12dp" />

    <EditText
        android:id="@+id/add_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/widget_field_bg"
        android:hint="@string/widget_add_hint"
        android:importantForAutofill="no"
        android:inputType="textCapSentences"
        android:imeOptions="actionDone"
        android:maxLines="1"
        android:padding="14dp"
        android:textColor="@color/widget_ink"
        android:textColorHint="@color/widget_faint"
        android:textSize="15sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end"
        android:paddingTop="14dp">

        <TextView
            android:id="@+id/add_cancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:text="@string/widget_cancel"
            android:textColor="@color/widget_muted"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/add_save"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/widget_field_bg"
            android:paddingStart="22dp"
            android:paddingEnd="22dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:text="@string/widget_save"
            android:textColor="@color/widget_accent"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
