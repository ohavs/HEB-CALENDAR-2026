<?xml version="1.0" encoding="utf-8"?>
<!-- תא יום. עיגול "היום" יושב מאחורי המספר, ולכן הוא FrameLayout. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cell_root"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_weight="1"
    android:padding="1dp">

    <View
        android:id="@+id/cell_today"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:layout_gravity="center_horizontal|top"
        android:layout_marginTop="1dp"
        android:background="@drawable/widget_cell_today"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal|top">

        <TextView
            android:id="@+id/cell_num"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:gravity="center"
            android:textColor="@color/widget_ink"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/cell_heb"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/widget_faint"
            android:textSize="9sp"
            android:maxLines="1" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="1dp">

            <View
                android:id="@+id/cell_holiday_dot"
                android:layout_width="4dp"
                android:layout_height="4dp"
                android:layout_marginStart="1dp"
                android:layout_marginEnd="1dp"
                android:background="@drawable/widget_dot_holiday"
                android:visibility="gone" />

            <View
                android:id="@+id/cell_event_dot"
                android:layout_width="4dp"
                android:layout_height="4dp"
                android:layout_marginStart="1dp"
                android:layout_marginEnd="1dp"
                android:background="@drawable/widget_dot_event"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
