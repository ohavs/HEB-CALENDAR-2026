            </LinearLayout>
        </LinearLayout>
        <LinearLayout style="@style/WidgetPreviewRow">
            <LinearLayout style="@style/WidgetPreviewCell">
                <TextView style="@style/WidgetPreviewNum" android:text="20" />
                <TextView style="@style/WidgetPreviewHeb" android:text="ט׳" />
                <LinearLayout style="@style/WidgetPreviewDots">
                    <ImageView style="@style/WidgetPreviewDot" android:background="@drawable/widget_dot_holiday" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout style="@style/WidgetPreviewCell">
                <TextView style="@style/WidgetPreviewNum" android:text="21" />
                <TextView style="@style/WidgetPreviewHeb" android:text="י׳" />
                <LinearLayout style="@style/WidgetPreviewDots">
                    <ImageView style="@style/WidgetPreviewDot" android:background="@drawable/widget_dot_yomtov" />
