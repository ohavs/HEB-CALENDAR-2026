            </LinearLayout>
            <LinearLayout style="@style/WidgetPreviewCell">
                <TextView style="@style/WidgetPreviewNum" android:text="30" />
                <TextView style="@style/WidgetPreviewHeb" android:text="י״ט" />
                <LinearLayout style="@style/WidgetPreviewDots">
                    <ImageView style="@style/WidgetPreviewDot" android:background="@drawable/widget_dot_holiday" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout style="@style/WidgetPreviewCell">
                <TextView style="@style/WidgetPreviewNum" android:text="1" android:textColor="@color/widget_faint" />
            </LinearLayout>
            <LinearLayout style="@style/WidgetPreviewCell">
                <TextView style="@style/WidgetPreviewNum" android:text="2" android:textColor="@color/widget_faint" />
            </LinearLayout>
            <LinearLayout style="@style/WidgetPreviewCell">
                <TextView style="@style/WidgetPreviewNum" android:text="3" android:textColor="@color/widget_faint" />
