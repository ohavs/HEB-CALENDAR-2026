                <TextView style="@style/WidgetPreviewHeb" android:text="י״ז" />
                <LinearLayout style="@style/WidgetPreviewDots">
                    <ImageView style="@style/WidgetPreviewDot" android:background="@drawable/widget_dot_holiday" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout style="@style/WidgetPreviewCell">
                <TextView style="@style/WidgetPreviewNum" android:text="29" />
                <TextView style="@style/WidgetPreviewHeb" android:text="י״ח" />
                <LinearLayout style="@style/WidgetPreviewDots">
                    <ImageView style="@style/WidgetPreviewDot" android:background="@drawable/widget_dot_holiday" />
