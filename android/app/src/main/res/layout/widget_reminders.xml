<?xml version="1.0" encoding="utf-8"?>
<!-- וידג׳ט התזכורות. הכותרת ב-Karantina, כמו כותרת מסך באפליקציה, והשורות
     הן אותם כרטיסי פסטל של מסך התזכורות. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rem_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:layoutDirection="rtl"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="14dp"
    android:paddingBottom="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="4dp"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/rem_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_reminders_title"
            android:fontFamily="@font/karantina_bold"
            android:includeFontPadding="false"
            android:textColor="@color/widget_ink"
            android:textSize="30sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/rem_count"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:fontFamily="@font/heebo_medium"
            android:textColor="@color/widget_muted"
            android:textSize="12sp"
            android:maxLines="1" />

        <ImageView
            android:id="@+id/rem_add"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/widget_add_bg"
            android:padding="10dp"
            android:src="@drawable/widget_ic_plus"
            android:contentDescription="@string/widget_add" />
    </LinearLayout>

    <TextView
        android:id="@+id/rem_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:fontFamily="@font/heebo_medium"
        android:text="@string/widget_empty_reminders"
        android:textColor="@color/widget_faint"
        android:textSize="13sp" />

    <ListView
        android:id="@+id/reminders_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:scrollbars="none" />
</LinearLayout>
