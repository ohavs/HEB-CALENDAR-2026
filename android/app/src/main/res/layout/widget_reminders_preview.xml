<?xml version="1.0" encoding="utf-8"?>
<!-- התצוגה המקדימה של וידג׳ט התזכורות בבורר של המשגר - ראו widget_preview.xml.
     אותן מידות של widget_reminders ושל שורותיו, עם פריטים לדוגמה. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:layoutDirection="rtl"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="14dp"
    android:paddingBottom="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="4dp"
        android:paddingBottom="4dp">

        <TextView style="@style/WidgetPreviewWidgetTitle" android:text="@string/widget_reminders_title" />
        <TextView style="@style/WidgetPreviewWidgetSub" android:text="@string/widget_preview_reminders_count" />

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/widget_add_bg"
            android:padding="10dp"
            android:src="@drawable/widget_ic_plus" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout style="@style/WidgetPreviewHeader">
            <TextView style="@style/WidgetPreviewHeaderLabel" android:text="@string/widget_preview_today" />
            <TextView style="@style/WidgetPreviewHeaderDate" android:text="@string/widget_preview_today_date" />
        </LinearLayout>
        <LinearLayout style="@style/WidgetPreviewItem" android:background="@drawable/widget_row_sky">
            <ImageView style="@style/WidgetPreviewCheck" />
            <TextView style="@style/WidgetPreviewTitle" android:text="@string/widget_preview_rem1" android:textColor="@color/widget_ev_sky_ink" />
            <TextView style="@style/WidgetPreviewTime" android:text="@string/widget_preview_rem1_time" android:textColor="@color/widget_ev_sky_ink" />
        </LinearLayout>
        <LinearLayout style="@style/WidgetPreviewItem" android:background="@drawable/widget_row_butter">
            <ImageView style="@style/WidgetPreviewCheck" />
            <TextView style="@style/WidgetPreviewTitle" android:text="@string/widget_preview_rem2" android:textColor="@color/widget_ev_butter_ink" />
        </LinearLayout>
        <LinearLayout style="@style/WidgetPreviewItem" android:background="@drawable/widget_row_done">
            <ImageView style="@style/WidgetPreviewCheck" android:background="@drawable/widget_check_on" android:src="@drawable/widget_ic_check" />
            <TextView style="@style/WidgetPreviewTitle" android:text="@string/widget_preview_rem4" android:textColor="@color/widget_faint" />
        </LinearLayout>

        <LinearLayout style="@style/WidgetPreviewHeader">
            <TextView style="@style/WidgetPreviewHeaderLabel" android:text="@string/widget_preview_tomorrow" />
            <TextView style="@style/WidgetPreviewHeaderDate" android:text="@string/widget_preview_tomorrow_date" />
        </LinearLayout>
        <LinearLayout style="@style/WidgetPreviewItem" android:background="@drawable/widget_row_mint">
            <ImageView style="@style/WidgetPreviewCheck" />
            <TextView style="@style/WidgetPreviewTitle" android:text="@string/widget_preview_rem3" android:textColor="@color/widget_ev_mint_ink" />
            <TextView style="@style/WidgetPreviewTime" android:text="@string/widget_preview_rem3_time" android:textColor="@color/widget_ev_mint_ink" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
