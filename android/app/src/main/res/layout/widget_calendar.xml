<?xml version="1.0" encoding="utf-8"?>
<!--
  וידג׳ט הלוח. אותה פריסה משרתת את כל הגדלים, ומה שמשתנה הוא מה מוצג:
  ראו CalendarWidgetProvider. הריפוד והכותרת רשומים שם (PAD, HEADER) -
  שינוי כאן מחייב שינוי שם.

  שם החודש ב-Karantina, והשנה לידו ב-Heebo: ספרות Karantina נקראות
  כאותיות. המחרוזת מגיעה שלמה ("נובמבר 2026"), והספק מפצל אותה.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cal_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:layoutDirection="rtl"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="14dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:id="@+id/cal_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/cal_month"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/karantina_bold"
            android:includeFontPadding="false"
            android:textColor="@color/widget_ink"
            android:textSize="30sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/cal_year"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:fontFamily="@font/heebo_bold"
            android:includeFontPadding="false"
            android:textColor="@color/widget_ink"
            android:textSize="18sp"
            android:maxLines="1"
            android:visibility="gone" />

        <TextView
            android:id="@+id/cal_hebrew"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:gravity="end"
            android:fontFamily="@font/heebo_medium"
            android:textColor="@color/widget_muted"
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/cal_weekdays"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="7"
        android:paddingBottom="2dp" />

    <LinearLayout
        android:id="@+id/cal_grid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical" />

    <LinearLayout
        android:id="@+id/cal_upcoming"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="6dp" />
</LinearLayout>
