<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:enableOnBackInvokedCallback="true"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- לחיצה על יום בוידג׳ט פותחת את אותו יום. הקישור נקרא
                 באותו קוד שקורא קיצורי דרך: src/lib/launchParams.ts -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="hebcal" />
            </intent-filter>

            <!-- "הוסף ליומן" מאפליקציות אחרות. באנדרואיד אין לוח ברירת מחדל
                 אחד: המשתמש בוחר אותנו כאן, עם "תמיד". MainActivity מתרגמת
                 את הכוונה לקישור hebcal:// - ראו src/lib/externalEvent.ts -->
            <intent-filter>
                <action android:name="android.intent.action.INSERT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="vnd.android.cursor.dir/event" />
            </intent-filter>

            <!-- קובץ הזמנה (.ics) שנפתח ממייל או מהקבצים -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="text/calendar" />
                <data android:mimeType="text/x-vcalendar" />
                <data android:mimeType="application/ics" />
            </intent-filter>

        </activity>

        <receiver
            android:name=".CalendarWidgetProvider"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_calendar_info" />
        </receiver>

        <receiver
            android:name=".RemindersWidgetProvider"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_reminders_info" />
        </receiver>

        <receiver
            android:name=".ShabbatWidgetProvider"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_shabbat_info" />
        </receiver>

        <receiver
            android:name=".SharedWidgetProvider"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_shared_info" />
        </receiver>

        <!--
            מקבל חציות גדר. exported=false: רק מערכת ההפעלה מפעילה אותו,
            דרך ה-PendingIntent שנרשם איתה.
        -->
        <receiver
            android:name=".GeofenceReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.ohav.hebcal.GEOFENCE" />
            </intent-filter>
        </receiver>

        <!-- אנדרואיד מוחק את הגדרות באתחול; כאן הן נרשמות מחדש -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".WidgetActionReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.ohav.hebcal.TOGGLE_DONE" />
                <action android:name="com.ohav.hebcal.TOGGLE_SHARED_DONE" />
            </intent-filter>
        </receiver>

        <!-- מסך הבחירה של הוידג׳ט המשותף. exported, כי המשגר הוא שפותח
             אותו כשמניחים את הוידג׳ט - ולא אנחנו. -->
        <activity
            android:name=".SharedWidgetConfigActivity"
            android:theme="@style/AppTheme.WidgetConfig"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- מסך הבחירה של וידג׳ט התזכורות. מגיעים אליו גם בהנחה וגם
             בלחיצה ארוכה, דרך reconfigurable ב-widget_reminders_info. -->
        <activity
            android:name=".RemindersWidgetConfigActivity"
            android:theme="@style/AppTheme.WidgetConfig"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- ההרשאה נדרשת כדי שמערכת ההפעלה תוכל לקשור את הרשימה -->
        <service
            android:name=".RemindersWidgetService"
            android:permission="android.permission.BIND_REMOTEVIEWS"
            android:exported="false" />

        <service
            android:name=".SharedWidgetService"
            android:permission="android.permission.BIND_REMOTEVIEWS"
            android:exported="false" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- תזכורות מקומיות. POST_NOTIFICATIONS נדרש מאנדרואיד 13 ומעלה. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- תזכורת שמגיעה באיחור של שעה לכניסת שבת היא תזכורת מיותרת, ולכן
         שעון מדויק. USE_EXACT_ALARM מותר לאפליקציות לוח שנה ושעון. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <!-- אחרי הפעלה מחדש של המכשיר התזכורות נקבעות שוב -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- התקנת עדכון מתוך האפליקציה. המשתמש מאשר פעם אחת בהגדרות, ואז
         כל עדכון עוד פעם אחת בחלון ההתקנה - שניהם חובה במערכת. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- התראות מבוססות מקום -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!--
      זו ההרשאה שמבדילה בין "עובד כשהאפליקציה פתוחה" לבין "עובד".
      בלעדיה מערכת ההפעלה אינה מנטרת את הגדרות כשהאפליקציה סגורה, וזה
      בדיוק הרגע שבו המשתמש בדרך למקום. מ-API 30 אי אפשר לבקש אותה
      בדיאלוג - רק המשתמש בוחר "לאפשר תמיד" במסך ההגדרות.
    -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <!-- המיקום אינו חובה: בלעדיו הכול עובד חוץ מהתראות הגעה ויציאה -->
    <uses-feature android:name="android.hardware.location" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
</manifest>
